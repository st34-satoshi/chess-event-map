<header class="site-header" data-controller="header">
  <div class="site-header__inner">
    <%= link_to root_path, class: "site-header__logo" do %>
      <%= image_tag "/favicon.png", alt: "チェスイベントマップ" %>
    <% end %>

    <button
      type="button"
      class="site-header__menu-button"
      data-header-target="button"
      data-action="header#toggle"
      aria-label="メニュー"
      aria-expanded="false"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <nav class="site-header__nav" data-header-target="nav">
      <%= link_to root_path, class: "site-header__link", data: { action: "header#close" } do %>
        <svg class="site-header__icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5S10.62 6.5 12 6.5s2.5 1.12 2.5 2.5S13.38 11.5 12 11.5z" fill="currentColor"/>
        </svg>
        <span>マップ</span>
      <% end %>

      <%= link_to new_place_path, class: "site-header__link", data: { action: "header#close" } do %>
        <svg class="site-header__icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm3.5 6.5h-2v2H11v-2H9v2H7v2h2v2h2v-2h2v-2h-2v-2z" fill="currentColor"/>
        </svg>
        <span>場所登録</span>
      <% end %>

      <%= link_to new_event_path, class: "site-header__link", data: { action: "header#close" } do %>
        <svg class="site-header__icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M19 4h-1V2h-2v2H8V2H6v2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10zM5 8V6h14v2H5zm7 6h5v5h-5v-5z" fill="currentColor"/>
        </svg>
        <span>イベント登録</span>
      <% end %>
    </nav>
  </div>
</header>
