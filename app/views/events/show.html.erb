<div class="form-page">
  <h1 class="form-page__title">イベント</h1>

  <div class="form__field">
    <span class="form__label">イベント名</span>
    <div class="form__value"><%= @event.title %></div>
  </div>

  <div class="form__field">
    <span class="form__label">会場</span>
    <div class="form__value">
      <%= link_to @event.place.name, @event.place, class: "form__link" %>
      <p class="form__hint"><%= @event.place.address %></p>
    </div>
  </div>

  <div class="form__field">
    <span class="form__label">開催日</span>
    <div class="form__value"><%= @event.held_on.strftime("%Y年%m月%d日") %></div>
  </div>

  <% if @event.url.present? %>
    <div class="form__field">
      <span class="form__label">詳細がわかるWebサイトやSNSなどのURL</span>
      <div class="form__value">
        <%= link_to @event.url, @event.url, class: "form__link", target: "_blank", rel: "noopener noreferrer" %>
      </div>
    </div>
  <% end %>
</div>
