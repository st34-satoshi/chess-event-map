<h1>場所</h1>

<dl>
  <dt>会場名</dt>
  <dd><%= @place.name %></dd>

  <dt>住所</dt>
  <dd><%= @place.address %></dd>

  <dt>緯度</dt>
  <dd><%= number_with_precision(@place.latitude, precision: 7, strip_insignificant_zeros: true) %></dd>

  <dt>経度</dt>
  <dd><%= number_with_precision(@place.longitude, precision: 7, strip_insignificant_zeros: true) %></dd>
</dl>

<p><%= link_to "別の場所を登録する", new_place_path %></p>
