<div class="form-page">
  <h1 class="form-page__title">会場を登録</h1>

  <%= form_with model: @place, class: "form" do |form| %>
    <% if @place.errors.any? %>
      <ul class="form__errors">
        <% @place.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    <% end %>

    <div class="form__field">
      <%= form.label :name, "会場名", class: "form__label" %>
      <%= form.text_field :name, required: true, placeholder: "例: 東京都庁", class: "form__input" %>
    </div>

    <div class="form__field">
      <%= form.label :address, "住所", class: "form__label" %>
      <%= form.text_field :address, required: true, placeholder: "例: 東京都新宿区西新宿２丁目８−１", class: "form__input" %>
    </div>

    <%= form.submit "登録する", class: "form__submit" %>
  <% end %>
</div>
